datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String          @id @default(uuid())
  name         String
  email        String          @unique
  password     String
  phone        String?
  role         String          @default("ATTENDEE") // ATTENDEE, ORGANIZER, ADMIN
  profileImage String?
  status       String          @default("ACTIVE") // ACTIVE, BLOCKED
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  events       Event[]         @relation("OrganizerEvents")
  bookings     Booking[]
  attendees    EventAttendee[]
  notifications Notification[]
  reviews      Review[]
  wishlist     Wishlist[]
}

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  image       String?
  icon        String?
  createdAt   DateTime @default(now())

  events      Event[]
}

model Event {
  id                   String          @id @default(uuid())
  organizerId          String
  title                String
  slug                 String          @unique
  description          String
  categoryId           String
  image                String
  date                 DateTime
  startTime            String
  endTime              String
  venue                String
  address              String
  city                 String
  state                String?
  country              String          @default("India")
  isOnline             Boolean         @default(false)
  streamUrl            String?
  capacity             Int             @default(100)
  registrationDeadline DateTime?
  status               String          @default("APPROVED") // APPROVED, PENDING, REJECTED, CANCELLED
  featured             Boolean         @default(false)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  organizer            User            @relation("OrganizerEvents", fields: [organizerId], references: [id], onDelete: Cascade)
  category             Category        @relation(fields: [categoryId], references: [id])
  tickets              Ticket[]
  bookings             Booking[]
  attendees            EventAttendee[]
  schedule             ScheduleItem[]
  speakers             Speaker[]
  reviews              Review[]
  wishlist             Wishlist[]
}

model ScheduleItem {
  id          String   @id @default(uuid())
  eventId     String
  title       String
  speaker     String?
  time        String
  description String?

  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model Speaker {
  id        String   @id @default(uuid())
  eventId   String
  name      String
  role      String
  company   String?
  bio       String?
  avatar    String?

  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model Ticket {
  id                String          @id @default(uuid())
  eventId           String
  name              String
  type              String          @default("GENERAL") // FREE, GENERAL, VIP, EARLY_BIRD, STUDENT, PREMIUM
  price             Float           @default(0.0)
  quantity          Int             @default(50)
  availableQuantity Int             @default(50)
  saleStart         DateTime?
  saleEnd           DateTime?
  createdAt         DateTime        @default(now())

  event             Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  bookings          Booking[]
  attendees         EventAttendee[]
}

model Booking {
  id            String          @id @default(uuid())
  bookingId     String          @unique // e.g. EE-2026-XXXX
  userId        String
  eventId       String
  ticketId      String
  quantity      Int             @default(1)
  totalAmount   Float           @default(0.0)
  paymentStatus String          @default("PAID") // PAID, PENDING, REFUNDED, FAILED
  bookingStatus String          @default("CONFIRMED") // CONFIRMED, CANCELLED
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  event         Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticket        Ticket          @relation(fields: [ticketId], references: [id])
  attendees     EventAttendee[]
  payment       Payment?
}

model EventAttendee {
  id             String    @id @default(uuid())
  bookingId      String
  userId         String
  eventId        String
  ticketId       String
  attendeeName   String
  attendeeEmail  String
  attendeePhone  String?
  qrCode         String    @unique // token for QR code scanning
  checkInStatus  String    @default("PENDING") // PENDING, CHECKED_IN
  checkedInAt    DateTime?
  createdAt      DateTime  @default(now())

  booking        Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  event          Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticket         Ticket    @relation(fields: [ticketId], references: [id])
}

model Payment {
  id                String    @id @default(uuid())
  bookingId         String    @unique
  transactionId     String    @unique
  amount            Float
  paymentMethod     String    @default("UPI") // UPI, CARD, NETBANKING, WALLET
  paymentStatus     String    @default("SUCCESS") // SUCCESS, PENDING, FAILED, REFUNDED
  razorpayOrderId   String?
  razorpayPaymentId String?
  paymentDate       DateTime  @default(now())
  createdAt         DateTime  @default(now())

  booking           Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String   @default("SYSTEM") // BOOKING, EVENT_UPDATE, REMINDER, ANNOUNCEMENT, SYSTEM
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  eventId   String
  rating    Int      @default(5)
  comment   String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

model Wishlist {
  id        String   @id @default(uuid())
  userId    String
  eventId   String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
}
